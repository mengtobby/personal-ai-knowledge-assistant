# Required: password for the single-user login
APP_PASSWORD=change-me

# Chat answers run against a local Ollama server (https://ollama.com) - no API key needed.
# Install Ollama, run `ollama pull llama3.1` (or another model), then `ollama serve`.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1

# Image/scanned-PDF OCR runs locally via Tesseract (bundled, no setup needed).

# Server
PORT=8787
DATA_DIR=./data

# Python ingest engine (parsing, chunking, embeddings).
# Setup once with `npm run setup:engine`; started automatically by `npm run dev`.
ENGINE_PORT=8788
# Override only if the engine runs elsewhere (defaults to http://127.0.0.1:ENGINE_PORT)
ENGINE_URL=

# Storage: "local" keeps file blobs on disk under DATA_DIR/blobs.
# Switch to "s3" and fill in the rest for any S3-compatible provider
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO...).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to "true" for MinIO and some providers that need path-style URLs
S3_FORCE_PATH_STYLE=false
