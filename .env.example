# Required: password for the single-user login
APP_PASSWORD=change-me

# Required for chat answers and image/scanned-PDF OCR
ANTHROPIC_API_KEY=sk-ant-...

# Models (defaults shown)
CHAT_MODEL=claude-sonnet-5
OCR_MODEL=claude-haiku-4-5-20251001

# Server
PORT=8787
DATA_DIR=./data

# Python ingest engine (parsing, chunking, embeddings).
# Setup once with `npm run setup:engine`; started automatically by `npm run dev`.
ENGINE_PORT=8788
# Override only if the engine runs elsewhere (defaults to http://127.0.0.1:ENGINE_PORT)
ENGINE_URL=

# Storage: "local" keeps file blobs on disk under DATA_DIR/blobs.
# Switch to "s3" and fill in the rest for any S3-compatible provider
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO...).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to "true" for MinIO and some providers that need path-style URLs
S3_FORCE_PATH_STYLE=false
